# Ohne Schlüssel antwortet die App mit festen Beispieltexten und zeigt das
# deutlich an. Mit Schlüssel läuft der echte Aufruf — keinen Modus-Schalter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Eingebautes web_search-Tool der Responses-API. 0 schaltet es ab und
# aktiviert echtes Token-Streaming (siehe README, langchainjs#8283).
LLM_WEB_SEARCH=1

# Bremsen
LLM_RATE_LIMIT=10
LLM_MAX_TOKENS=700
LLM_MAX_ZEICHEN=4000
