# LLM
# mock  = deterministische Fixtures, kein Netz, keine Kosten (Standard)
# live  = echter Aufruf über @langchain/openai
LLM_MODE=mock

# Nur für LLM_MODE=live. Niemals im Client, niemals committen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Eingebautes web_search-Tool der Responses-API. 0 schaltet es ab und
# aktiviert echtes Token-Streaming (siehe README, langchainjs#8283).
LLM_WEB_SEARCH=1

# Optionaler Ersatz für web_search, falls der Spike scheitert.
TAVILY_API_KEY=

# Bremsen
LLM_RATE_LIMIT=10
LLM_MAX_TOKENS=700
LLM_MAX_ZEICHEN=4000
